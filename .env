HOST=0.0.0.0
PORT=9000
APP_ENV=local
DEBUG=True

# Database
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_explorer
DB_USER=postgres
DB_PASSWORD=test

# JWT
JWT_SECRET_KEY=change-this-secret-key-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

